# Database
DATABASE_URL=postgresql+asyncpg://autodidact:autodidact@localhost:5432/autodidact

# LLM provider: mock | openai_compatible
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.2

# Search provider: auto | brave | duckduckgo
# auto uses Brave when a key is configured and falls back to DuckDuckGo HTML.
SEARCH_PROVIDER=auto
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_BASE_URL=https://api.search.brave.com/res/v1/web/search
SEARCH_TIMEOUT_SECONDS=30

# Agent
AGENT_CONFIG=config/agent.yaml
HTTP_USER_AGENT=Autodidact/0.1 (+local research agent)
LOG_LEVEL=INFO

# 可选：独立裁判模型；留空时复用学习模型，仍隔离请求上下文
JUDGE_LLM_MODEL=
JUDGE_LLM_BASE_URL=
JUDGE_LLM_API_KEY=
LLM_MAX_OUTPUT_TOKENS=2048
# 填写提供方合同价格后才可估算金额；0不代表实际调用免费
LLM_INPUT_USD_PER_MILLION=0
LLM_OUTPUT_USD_PER_MILLION=0

# 可选嵌入；当前要求1536维，指纹变化后可运行 rebuild-embeddings
EMBEDDING_PROVIDER=disabled
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# 可选网页认知来源：多个配置名用逗号分隔
WEB_MODELS_CONFIG=config/web_models.yaml
# 六站工作台个人配置（默认全部关闭）；不自动更改下方学习循环名单。
WEB_AUXILIARY_CONFIG=config/web_auxiliary.json
ENABLED_WEB_MODELS=
# 可选30天实验：填写 freeze-benchmark 返回的ID，会增加模型调用
BENCHMARK_SNAPSHOT_ID=
# 比较另一服务模型时可设置其密钥，不通过命令行传递
MIGRATION_NEW_API_KEY=

# F09 可选：只汇总既有可靠基准/掌握缺口，不启用上面的收费里程碑评估
MASTERY_BENCHMARK_ID=
# 多个模型/记忆条件时必须从mastery输出选择group_id；不自动选最好一组
MASTERY_GROUP_ID=

# F10可选概念关系：启用后普通学习额外提取/核对最多2条关系（模型可能收费）；默认关闭。
# 先备份、显式init-db升级0010；不会自动迁移、回填旧主张或运行考试。
KNOWLEDGE_GRAPH_ENABLED=false

# F11：手工配置来源清单，列出/冻结/路由不调用模型；只有显式run阶段可能收费。
COGNITIVE_SOURCES_CONFIG=config/cognitive_sources.json
